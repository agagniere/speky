{
  "name": "speky",
  "description": "Skills to best use Speky, the requirements and test specification manager.",
  "author": {
    "name": "Antoine Gagniere",
    "email": "antoine@gagniere.dev",
    "url": "https://github.com/agagniere"
  },
  "homepage": "https://agagniere.github.io/speky",
  "repository": "https://github.com/agagniere/speky",
  "license": "MIT",
  "keywords": [
    "specification",
    "requirements"
  ],
  "skills": [
    "./claude_plugin/skills/init",
    "./claude_plugin/skills/speky-workflow",
    "./claude_plugin/skills/write-test-plans"
  ],
  "agents": [
    "./claude_plugin/agents/code-test-reviewer.md",
    "./claude_plugin/agents/requirement-reviewer.md",
    "./claude_plugin/agents/test-plan-author.md",
    "./claude_plugin/agents/test-plan-reviewer.md"
  ],
  "mcpServers": {
    "speky": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "speky-mcp",
        "specs/spec.yaml"
      ],
      "env": {
        "UV_CACHE_DIR": "${CLAUDE_PLUGIN_DATA}/uvcache",
        "UV_PROJECT": "${CLAUDE_PLUGIN_ROOT}"
      }
    },
    "speky-selfspec": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "speky-mcp",
        "specs/speky.yaml",
        "specs/mcp/mcp.toml"
      ],
      "env": {
        "UV_CACHE_DIR": "${CLAUDE_PLUGIN_DATA}/uvcache",
        "UV_WORKING_DIR": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  }
}
